# ============================================================
#  .env.example — Copia este archivo como .env y ajusta los valores
#  NO compartas el .env real (contiene credenciales reales)
# ============================================================

# Perfil activo de recursos (PROFILE_A_BASELINE | PROFILE_B_MEDIUM | PROFILE_C_SEVERE)
PROFILE=PROFILE_A_BASELINE

# Límite de CPU para los contenedores de BD (ej. 4.0, 2.0, 0.5)
DB_CPUS=4.0

# Límite de memoria para los contenedores de BD (ej. 4096M, 2048M, 512M)
DB_MEMORY=4096M

# Credenciales de PostgreSQL
POSTGRES_USER=tu_usuario
POSTGRES_PASSWORD=tu_password_seguro
POSTGRES_DB=it2id_universidad

# Base de datos de MongoDB
MONGO_INITDB_DATABASE=it2id_universidad
